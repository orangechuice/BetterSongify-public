# Generated bundle output
dist/

# Dependency folders
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local environment files. Never commit credentials — this project needs none
# to build, and anything that shows up here is a mistake.
.env
.env.*
!.env.example

# macOS and editor/AI metadata
.DS_Store
.idea/
.vscode/
.gemini/
# Agent config and session state stay local, but .claude/skills/ is checked in:
# it tells anyone working here that this repo is a derived mirror. Needs the glob
# form — git does not descend into an excluded directory, so a negation under
# `.claude/` would never run.
.claude/*
!.claude/skills/

# Temporary files and local Spotify package artifacts. xpui.spa is Spotify's
# own application bundle: the installer unpacks and repacks it in place, and it
# is not ours to redistribute, so it must never be committed here.
*.tmp
*.bak
*.zip
*.spa
xpui.spa*
BetterSongify_Extraction.*

# Local agent config: names the private repo on this machine. Never published.
.claude/
